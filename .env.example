# SQL Buddy needs one AI key to turn questions into SQL. Without a key it runs in
# demo mode: a small built-in translator that handles simple questions.
# Copy this file to .env.local and fill in ONE option. Never commit .env.local.

# Option 1: Claude (Anthropic). Takes priority when set.
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=low

# Option 2: any OpenAI-compatible chat API. Mistral is the default.
LLM_API_KEY=
# LLM_BASE_URL=https://api.mistral.ai/v1
# LLM_MODEL=mistral-small-latest

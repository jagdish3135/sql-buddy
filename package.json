{
  "name": "sql-buddy",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Drop in CSVs, ask questions in plain English. SQL Buddy writes the SQL, shows it, runs it in your browser with DuckDB and charts the answer.",
  "scripts": {
    "dev": "vite --port 5200 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 5201 --strictPort",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "samples": "node scripts/make-samples.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@duckdb/duckdb-wasm": "1.32.0",
    "apache-arrow": "^17.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
